! Generated by render.py from configs/vars/{{ hostname }}.yml - do not edit by hand.
! Edit the vars/*.yml file and re-run render.py instead.
!
hostname {{ hostname }}
!
interface Loopback0
 description Router ID / management loopback
 ip address {{ loopback_ip }} 255.255.255.255
!
{% for wan in wan_interfaces %}
interface {{ wan.name }}
 description {{ wan.description }}
 ip address {{ wan.ip }} {{ wan.netmask }}
{% if wan.acl_out %}
 ip access-group {{ wan.acl_out }} out
{% endif %}
!
{% endfor %}
{% for lan in lan_interfaces %}
interface {{ lan.name }}
 description {{ lan.description }}
 ip address {{ lan.ip }} {{ lan.netmask }}
{% if lan.acl_out %}
 ip access-group {{ lan.acl_out }} out
{% endif %}
!
{% endfor %}
{% for acl in acls %}
ip access-list extended {{ acl.name }}
{% for line in acl.lines %}
 {{ line }}
{% endfor %}
!
{% endfor %}
router bgp {{ as_number }}
 bgp router-id {{ loopback_ip }}
{% for lan in lan_interfaces %}
 network {{ lan.network }} mask {{ lan.netmask }}
{% endfor %}
{% for wan in wan_interfaces %}
 neighbor {{ wan.neighbor_ip }} remote-as {{ wan.neighbor_as }}
 neighbor {{ wan.neighbor_ip }} description {{ wan.neighbor_description }}
{% endfor %}
!
end
